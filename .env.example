NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://user:password@localhost:5432/km_barber?schema=public

DB_POOL_MIN=2
DB_POOL_MAX=10

JWT_ACCESS_SECRET=change-this-to-a-strong-random-secret-key
JWT_REFRESH_SECRET=change-this-to-another-strong-random-secret-key
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
COOKIE_SECRET=change-this-cookie-secret

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
