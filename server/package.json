{
  "name": "km-barber-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "KM-BARBER backend API",
  "main": "server.js",
  "scripts": {
    "start": "npx prisma migrate deploy && node server.js",
    "dev": "node --watch server.js",
    "migrate": "npx prisma migrate deploy",
