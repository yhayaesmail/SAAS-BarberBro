generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  BARBER
  CUSTOMER
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model User {
  id        String   @id @default(uuid())
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  email     String   @unique
  phone     String?
  password  String
  role      Role     @default(CUSTOMER)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  barber      Barber?
  reservations Reservation[] @relation("CustomerReservations")

  @@index([email])
  @@index([role])
  @@map("users")
}

model Barber {
  id        String   @id @default(uuid())
  name      String
  username  String   @unique
  bio       String   @default("")
  imageUrl  String?  @map("image_url")
  phone1    String   @map("phone_1")
  phone2    String   @map("phone_2")
  email     String?
  startTime String   @map("start_time")
  endTime   String   @map("end_time")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  services      BarberService[]
  reservations  Reservation[]
  workingHours  WorkingHours[]

  @@index([active])
  @@map("barbers")
}

model Service {
  id          String   @id @default(uuid())
  name        String
  description String   @default("")
  price       Decimal  @db.Decimal(10, 2)
  duration    Int
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  barberServices      BarberService[]
  reservationServices ReservationService[]

  @@index([active])
  @@map("services")
}

model BarberService {
  id        String   @id @default(uuid())
  price     Decimal? @db.Decimal(10, 2)
  duration  Int?
  createdAt DateTime @default(now()) @map("created_at")

  barberId  String  @map("barber_id")
  serviceId String  @map("service_id")
  barber    Barber  @relation(fields: [barberId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([barberId, serviceId])
  @@map("barber_services")
}

model Reservation {
  id            String            @id @default(uuid())
  startTime     DateTime          @map("start_time")
  endTime       DateTime          @map("end_time")
  totalPrice    Decimal           @map("total_price") @db.Decimal(10, 2)
  totalDuration Int               @map("total_duration")
  status        ReservationStatus @default(CONFIRMED)
  customerPhone String            @map("customer_phone")
  customerEmail String?           @map("customer_email")
  notes         String            @default("")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  customerId String @map("customer_id")
  barberId   String @map("barber_id")

  customer User   @relation("CustomerReservations", fields: [customerId], references: [id])
  barber   Barber @relation(fields: [barberId], references: [id])

  services ReservationService[]

  @@index([barberId, startTime, endTime])
  @@index([customerId])
  @@index([status])
  @@index([startTime])
  @@map("reservations")
}

model ReservationService {
  id        String  @id @default(uuid())
  price     Decimal @db.Decimal(10, 2)
  duration  Int

  reservationId String @map("reservation_id")
  serviceId     String @map("service_id")

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id])

  @@map("reservation_services")
}

model WorkingHours {
  id        String  @id @default(uuid())
  dayOfWeek Int     @map("day_of_week")
  startTime String  @map("start_time")
  endTime   String  @map("end_time")
  isActive  Boolean @default(true) @map("is_active")

  barberId String @map("barber_id")
  barber   Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@unique([barberId, dayOfWeek])
  @@map("working_hours")
}
